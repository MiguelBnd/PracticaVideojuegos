<Window x:Class="PracticaVideojuegos.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión" Height="320" Width="420" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="{DynamicResource LoginBackgroundBrush}">

    <Window.Resources>
        <LinearGradientBrush x:Key="LoginBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF1E293B" Offset="0"/>
            <GradientStop Color="#FF0F172A" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="TextBlock">
            <!-- Color para etiquetas y textos generales -->
            <Setter Property="Foreground" Value="#FFD166"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#0B2633" />
            <Setter Property="BorderBrush" Value="#06B6D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#0B2633" />
            <Setter Property="BorderBrush" Value="#06B6D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#06B6D4"/>
            <Setter Property="Foreground" Value="#062C33"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#035E63" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Iniciar sesión" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <TextBlock Text="Usuario"/>
            <TextBox Name="TxtUsuario" />

            <TextBlock Text="Contraseña"/>
            <PasswordBox Name="PwdPassword" />

            <TextBlock Name="TxtMensaje" Foreground="Tomato" FontWeight="SemiBold" Margin="0,6,0,10" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Width="100" Margin="6" Click="BtnLogin_Click" IsDefault="True">Login</Button>
                <Button Width="100" Margin="6" Click="BtnSalir_Click" IsCancel="True">Salir</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>