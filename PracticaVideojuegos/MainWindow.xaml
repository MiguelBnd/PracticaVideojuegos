<Window x:Class="PracticaVideojuegos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PracticaVideojuegos"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="900">

    <Grid Margin="20">
       
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtWelcome" Text="" FontSize="22" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,6"/>

        <Button Grid.Row="0" 
        HorizontalAlignment="Right" 
        VerticalAlignment="Bottom"
        Margin="0,0,15,6" 
        Click="BtnPerfil_Click" 
        Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter/>
                </ControlTemplate>
            </Button.Template>
            <TextBlock Text="Mi Perfil" 
               Foreground="Blue" 
               TextDecorations="Underline" 
               FontSize="16" 
               FontWeight="SemiBold"/>
        </Button>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
               
                <ColumnDefinition Width="*"/>
                
            </Grid.ColumnDefinitions>

            
            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" CornerRadius="30" Margin="5" Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Destacados" Margin="0,30" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center"/>
                    <TextBlock Text="Mis juegos" Margin="0,30" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center"/>
                    <TextBlock Text="Configuración" Margin="0,30" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            
            <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,0,0,0">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="TIENDA" Margin="15,0" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="COMUNIDAD" Margin="15,0" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="SOPORTE" Margin="15,0" FontSize="18" FontWeight="Bold"/>
                </StackPanel>

              
                <Border BorderBrush="Black" 
                        BorderThickness="2" 
                        Width="700" 
                        Height="420" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Padding="10">

                    <!-- Menos juegos: dos filas de 3 (total 6). Rectángulos verticales -->
                    <StackPanel>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Border Width="120" Height="160" BorderBrush="#80FFFFFF" BorderThickness="2" Margin="6" CornerRadius="6">
                                <Button Background="Transparent" BorderThickness="0" Click="GameButton_Click" Tag="Fallout 3" Cursor="Hand">
                                    <StackPanel>
                                        <Image Source="pack://application:,,,/PracticaVideojuegos;component/imagenes/imagen1.png" Stretch="UniformToFill" Width="116" Height="120"/>
                                        <TextBlock Text="Fallout 3" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <Border Width="120" Height="160" BorderBrush="#80FFFFFF" BorderThickness="2" Margin="6" CornerRadius="6">
                                <Button Background="Transparent" BorderThickness="0" Click="GameButton_Click" Tag="FC27" Cursor="Hand">
                                    <StackPanel>
                                        <Image Source="pack://application:,,,/PracticaVideojuegos;component/imagenes/imagen3.jpg" Stretch="UniformToFill" Width="116" Height="120"/>
                                        <TextBlock Text="FC27" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <Border Width="120" Height="160" BorderBrush="#80FFFFFF" BorderThickness="2" Margin="6" CornerRadius="6">
                                <Button Background="Transparent" BorderThickness="0" Click="GameButton_Click" Tag="Rocket League" Cursor="Hand">
                                    <StackPanel>
                                        <Image Source="pack://application:,,,/PracticaVideojuegos;component/imagenes/imagen4.jpg" Stretch="UniformToFill" Width="116" Height="120"/>
                                        <TextBlock Text="Rocket League" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
                            <Border Width="120" Height="160" BorderBrush="#80FFFFFF" BorderThickness="2" Margin="6" CornerRadius="6">
                                <Button Background="Transparent" BorderThickness="0" Click="GameButton_Click" Tag="Roblox" Cursor="Hand">
                                    <StackPanel>
                                        <Image Source="pack://application:,,,/PracticaVideojuegos;component/imagenes/imagen5.jpg" Stretch="UniformToFill" Width="116" Height="120"/>
                                        <TextBlock Text="Roblox" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <Border Width="120" Height="160" BorderBrush="#80FFFFFF" BorderThickness="2" Margin="6" CornerRadius="6">
                                <Button Background="Transparent" BorderThickness="0" Click="GameButton_Click" Tag="PUBG" Cursor="Hand">
                                    <StackPanel>
                                        <Image Source="pack://application:,,,/PracticaVideojuegos;component/imagenes/imagen6.jpg" Stretch="UniformToFill" Width="116" Height="120"/>
                                        <TextBlock Text="PUBG" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <Border Width="120" Height="160" BorderBrush="#80FFFFFF" BorderThickness="2" Margin="6" CornerRadius="6">
                                <Button Background="Transparent" BorderThickness="0" Click="GameButton_Click" Tag="Among Us" Cursor="Hand">
                                    <StackPanel>
                                        <Image Source="pack://application:,,,/PracticaVideojuegos;component/imagenes/imagen7.jpg" Stretch="UniformToFill" Width="116" Height="120"/>
                                        <TextBlock Text="Among Us" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                 </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>